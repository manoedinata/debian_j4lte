[Unit]
Description=Rear camera V4L2 bridge (camd -> /dev/video20)
# The firmware (fimc_is_lib.bin, setfile_*.bin) lives on the stock VENDOR
# partition, which the initramfs already mounted; make sure systemd agrees.
RequiresMountsFor=/vendor
After=local-fs.target

[Service]
# v4l2loopback is built out of tree for this kernel (see build_camd.sh); the
# leading '-' tolerates it already being loaded when the service restarts.
ExecStartPre=-/sbin/insmod /usr/local/lib/camd/v4l2loopback.ko devices=1 video_nr=20 exclusive_caps=1 "card_label=\"J4 Rear Camera\""
ExecStart=/usr/local/sbin/camd -d /dev/video20
Restart=on-failure
# do not hammer the camera driver if bring-up keeps failing
RestartSec=10

[Install]
WantedBy=multi-user.target
