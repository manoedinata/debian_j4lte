[Unit]
Description=Rear camera V4L2 bridge (camd -> /dev/video20)
# The firmware (fimc_is_lib.bin, setfile_*.bin) lives on the stock VENDOR
# partition, which the initramfs already mounted; make sure systemd agrees.
RequiresMountsFor=/vendor
Requires=camd-loopback.service
After=local-fs.target camd-loopback.service

[Service]
# published size after rotation; the MCSC hardware scaler does the shrinking for free.
# The rear sensor is mounted sideways; add "-r 0|90|180|270" to override the rotation.
ExecStart=/usr/local/sbin/camd -c rear -d /dev/video20 -s 480x640
Restart=on-failure
# do not hammer the camera driver if bring-up keeps failing
RestartSec=10

[Install]
WantedBy=multi-user.target
